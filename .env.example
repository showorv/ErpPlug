# Copy to .env at the repo root and adjust if needed. Values match infra/docker-compose.yml.
# Local development only: never put real secrets in this file.

NODE_ENV=development

# apps/api
API_PORT=3000
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API from a browser (web and admin dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL (Uday will split this into migrator and app roles in Phase 0)
DATABASE_URL=postgresql://erpplug:erpplug@localhost:5432/erpplug

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (RustFS locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=erpplug
S3_SECRET_KEY=erpplug-secret
S3_BUCKET=erpplug

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ErpPlug <no-reply@erpplug.local>"
