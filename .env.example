# Template for the git-ignored .env at the repo root. Create .env with:  pnpm setup:env
# That copies this file and fills every empty secret below with a random local value.
# Never put credentials in a committed file, not even local ones.
# infra/docker-compose.yml and apps/api both read .env.

NODE_ENV=development

# ---- Local Docker services (infra/docker-compose.yml) ----
POSTGRES_USER=erpplug
POSTGRES_DB=erpplug
# Filled by pnpm setup:env
POSTGRES_PASSWORD=

S3_ACCESS_KEY=erpplug
# Filled by pnpm setup:env
S3_SECRET_KEY=

# ---- apps/api ----
API_PORT=3000
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API from a browser (web and admin dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Built from the values above (Uday will split this into migrator and app roles in Phase 0).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379

# Background worker (apps/worker). Jobs per queue at once, and the Redis key prefix for queues.
WORKER_CONCURRENCY=5
QUEUE_PREFIX=erpplug

# S3-compatible object storage (RustFS locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=erpplug

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ErpPlug <no-reply@erpplug.local>"
