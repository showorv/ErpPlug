{
  "name": "erpplug",
  "private": true,
  "description": "ErpPlug: modular, multi-tenant, subscription ERP platform (monorepo)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
